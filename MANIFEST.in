# Include documentation and license files
include README.md
include LICENSE
include CHANGELOG.md
include COMMERCIAL-LICENSE.md
include requirements.txt

# Include Cython source files for building extensions
recursive-include pyfaceau/utils/cython_extensions *.pyx *.pxd *.c

# Include pre-compiled Cython extensions (platform-specific)
# These provide 240x speedup for running median calculation
include pyfaceau/*.so
include pyfaceau/cython_*.so

# Include package data files
recursive-include pyfaceau *.txt *.json

# Exclude compiled files and caches (except our Cython extensions)
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .DS_Store

# Never ship model files. OpenFace's files are licensed for non-commercial
# research only and may not be redistributed; pyfaceau-download-models fetches
# them from OpenFace after the user accepts the OpenFace license.
prune weights
global-exclude *.dat *.onnx *.pth *.pt *.mlmodel *.h5 *.hdf5 *.npz *.npy *.pkl *.tflite *.caffemodel *.safetensors
global-exclude In-the-wild_aligned_PDM_*.txt tris_68*.txt svr_patches_*.txt cen_patches_* ccnf_patches_*

# Exclude development files
exclude .gitignore
exclude .gitattributes
recursive-exclude tests *
recursive-exclude tools *
recursive-exclude benchmarks *
recursive-exclude docs *
